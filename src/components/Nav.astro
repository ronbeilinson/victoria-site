---
interface Props {
  currentPage?: string;
}
const { currentPage = '' } = Astro.props;

const links = [
  { href: '/',        label: 'Home'     },
  { href: '/about',   label: 'About Me' },
  { href: '/work',    label: 'Work'     },
  { href: '/contact', label: 'Contact'  },
];
---

<!-- No bottom border — keep it light and floating like sjbruce -->
<header class="flex items-center justify-between px-6 md:px-10 pt-7 pb-6">

  <!-- Wordmark: monogram stamp + formal calligraphy script -->
  <a
    href="/"
    class="flex items-center gap-3 text-ink leading-none"
    aria-label="Victoria Tarantino — home"
  >
    <img src="/monogram.svg" alt="" aria-hidden="true" class="w-9 h-9 md:w-10 md:h-10 shrink-0" />
    <span class="signature" style="font-size: 1.9rem; letter-spacing: 0.01em;">Victoria Tarantino</span>
  </a>

  <!-- Desktop links -->
  <nav class="hidden md:flex items-center gap-9" aria-label="Primary">
    {links.map((l) => (
      <a href={l.href} class={`nav-link${currentPage === l.href ? ' active' : ''}`}>
        {l.label}
      </a>
    ))}
  </nav>

  <!-- Mobile hamburger -->
  <button
    id="menu-btn"
    class="menu-btn md:hidden flex flex-col gap-[5px] p-1 -mr-1 z-50 relative"
    aria-label="Open navigation"
    aria-expanded="false"
  >
    <span class="ham-line"></span>
    <span class="ham-line"></span>
    <span class="ham-line"></span>
  </button>
</header>

<!-- Full-screen mobile overlay -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <button
    id="menu-close"
    class="absolute top-7 right-6 flex flex-col gap-[5px] p-1"
    aria-label="Close navigation"
  >
    <span class="ham-line" style="transform: translateY(4px) rotate(45deg);"></span>
    <span class="ham-line opacity-0"></span>
    <span class="ham-line" style="transform: translateY(-4px) rotate(-45deg);"></span>
  </button>

  <nav class="flex flex-col items-center gap-7" aria-label="Mobile">
    {links.map((l) => (
      <a href={l.href} class="mobile-nav-link" data-close>{l.label}</a>
    ))}
  </nav>
</div>

<script>
  const btn   = document.getElementById('menu-btn')   as HTMLButtonElement;
  const close = document.getElementById('menu-close') as HTMLButtonElement;
  const menu  = document.getElementById('mobile-menu') as HTMLDivElement;

  const open = () => {
    btn.classList.add('is-open');
    menu.classList.add('is-open');
    menu.setAttribute('aria-hidden', 'false');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const shut = () => {
    btn.classList.remove('is-open');
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  btn.addEventListener('click', open);
  close.addEventListener('click', shut);
  document.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', shut));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(); });
</script>
