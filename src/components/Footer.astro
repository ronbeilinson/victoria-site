---
const year = new Date().getFullYear();
---
<footer class="px-6 md:px-10 py-12 md:py-14 border-t border-rule mt-auto">
  <div class="flex flex-col sm:flex-row gap-10 sm:gap-20">

    <!-- About column -->
    <div class="flex flex-col gap-2.5">
      <p class="text-[11px] font-sans text-ink tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">About</p>
      <a href="/about"    class="footer-link">My Story</a>
      <a href="/services" class="footer-link">Services</a>
      <a href="/gallery"  class="footer-link">Gallery</a>
      <a href="/contact"  class="footer-link">Contact</a>
    </div>

    <!-- Follow Me column -->
    <div class="flex flex-col gap-2.5">
      <p class="text-[11px] font-sans text-ink tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">Follow Me</p>
      <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="footer-link">Instagram</a>
      <a href="https://www.linkedin.com/in/victoria-tarantino" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
    </div>

  </div>

  <p class="text-ink-light text-xs font-sans mt-10" style="letter-spacing:0.02em;">
    © {year} Victoria Tarantino
  </p>
</footer>
