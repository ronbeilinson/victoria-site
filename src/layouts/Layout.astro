---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Victoria Tarantino — Event Architecture & Brand Experiences',
  description =
    "New York City–based event producer behind the world's most exclusive conferences and international events, including Sun Valley, Allen & Co, and Endeavor Global.",
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://victtarts.com" />

    <!-- Cormorant Garamond: the signature face -->
    <!-- DM Sans: clean workhorse for everything else -->
    <!-- Pinyon Script: formal calligraphy for the wordmark + display headings -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink font-sans">
    <slot />
  </body>

</html>
