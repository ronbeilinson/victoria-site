---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!--
  Connect the form to Formspree (free — 50 submissions/month):
  1. formspree.io → sign up → New Form → copy the endpoint URL
  2. Replace REPLACE_WITH_YOUR_FORM_ID below

  Resume: upload your PDF to /public/resume.pdf
-->

<Layout
  title="Contact — Victoria Tarantino"
  description="Reach out to Victoria Tarantino to discuss your event."
>
  <Nav currentPage="/contact" />

  <main class="flex-1 px-6 md:px-10 pt-10 pb-20">
    <h1
      class="signature text-ink leading-none mb-8"
      style="font-size: clamp(2.6rem, 6.5vw, 5rem);"
    >
      Let's connect.
    </h1>

    <div class="rule mb-10"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-start">

      <!-- Left: intro + photo -->
      <div class="flex flex-col gap-7">
        <p class="text-ink-mid text-sm font-sans leading-relaxed" style="max-width:38ch; letter-spacing:0.01em;">
          Whether you're planning an event, exploring a partnership, or simply want to say hello, I'd love to hear from you.
        </p>

        <div class="flex flex-col gap-5 text-sm font-sans">
          <div>
            <p class="text-[11px] font-sans text-ink-light tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">Contact</p>
            <a href="mailto:victtarts@gmail.com" class="text-ink hover:opacity-40 transition-opacity duration-200">victtarts@gmail.com</a>
            &nbsp;•&nbsp;
            <a href="https://www.linkedin.com/in/victoriatarantino/" target="_blank" rel="noopener noreferrer" class="text-ink hover:opacity-40 transition-opacity duration-200">LinkedIn</a>
          </div>
          <div>
            <p class="text-[11px] font-sans text-ink-light tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">Based in</p>
            <p class="text-ink">New York, New York</p>
          </div>
          <div>
            <p class="text-[11px] font-sans text-ink-light tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">Specialties</p>
            <p class="text-ink leading-relaxed">
              Conferences &nbsp;•&nbsp; Executive Retreats &nbsp;•&nbsp; Brand Activations &nbsp;•&nbsp; Experiential Marketing<br />VIP Hospitality &nbsp;•&nbsp; Global Event Production
            </p>
          </div>
        </div>

        <!-- Resume download -->
        <div class="pt-1">
          <a
            href="/Victoria_Tarantino_Resume_626.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn self-start"
          >
            Download My Resume
            <svg class="inline-block ml-2 mb-0.5" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M5 1v5M5 6l-2-2M5 6l2-2M1 9h8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- Right: form -->
      <form
        id="contact-form"
        action="https://formspree.io/f/mbdeezpl"
        method="POST"
        class="flex flex-col gap-7"
      >
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Name</label>
          <input type="text" id="name" name="name" required placeholder="Your Name" class="field" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="company" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Company (Optional)</label>
          <input type="text" id="company" name="company" placeholder="Organization or Company" class="field" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Email</label>
          <input type="email" id="email" name="email" required placeholder="your@email.com" class="field" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="type" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">How Can I Help?</label>
          <input type="text" id="type" name="type" placeholder="Opportunity, collaboration, event inquiry, networking, speaking engagement."class="field" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Tell Me More</label>
          <textarea id="message" name="message" rows="1" required placeholder="Share a few details about your inquiry, project, or opportunity." class="field resize-none" style="overflow-y: hidden;"></textarea>
        </div>

        <div class="pt-1">
          <button type="submit" class="btn">Get In Touch</button>
        </div>

        <p id="form-success" class="hidden text-ink-mid text-sm font-sans">
          Thanks for reaching out, I'll be in touch soon!
        </p>
      </form>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const action = form.getAttribute('action') ?? '';

    if (action.includes('REPLACE_WITH_YOUR_FORM_ID')) {
      success.classList.remove('hidden');
      success.textContent = '✓ (Form not yet connected — see README for Formspree setup.)';
      return;
    }

    const res = await fetch(action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    });

    if (res.ok) {
      form.reset();
      success.classList.remove('hidden');
    }
  });
</script>
