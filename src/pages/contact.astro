---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!--
  Connect the form to Formspree (free — 50 submissions/month):
  1. formspree.io → sign up → New Form → copy the endpoint URL
  2. Replace REPLACE_WITH_YOUR_FORM_ID below
-->

<Layout
  title="Contact — Victoria Tarantino"
  description="Reach out to Victoria Tarantino to discuss your event."
>
  <Nav currentPage="/contact" />

  <main class="flex-1 px-6 md:px-10 pt-10 pb-20">
    <div class="rule mb-10"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-start">

      <!-- Left: intro -->
      <div class="flex flex-col gap-7">
        <h1
          class="font-serif text-ink font-light leading-tight"
          style="font-size: clamp(2rem, 5vw, 3.8rem); font-style: italic;"
        >
          Let's talk about<br />your event.
        </h1>

        <div class="rule"></div>

        <p class="text-ink-mid text-sm font-sans leading-relaxed" style="max-width:38ch; letter-spacing:0.01em;">
          Whether you have a full brief or just a feeling — reach out. I take on a limited number of projects each year to make sure every client gets my full attention.
        </p>

        <div class="flex flex-col gap-5 text-sm font-sans">
          <div>
            <p class="text-[11px] font-sans text-ink-light tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">Email</p>
            <a href="mailto:vttarantino@gmail.com" class="text-ink hover:opacity-40 transition-opacity duration-200">
              vttarantino@gmail.com
            </a>
          </div>
          <div>
            <p class="text-[11px] font-sans text-ink-light tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">Based in</p>
            <p class="text-ink">New York City, New York</p>
          </div>
          <div>
            <p class="text-[11px] font-sans text-ink-light tracking-widest uppercase mb-1" style="letter-spacing:0.18em;">Available for</p>
            <p class="text-ink leading-relaxed">
              Conferences &nbsp;·&nbsp; Brand Activations<br />
              International Events &nbsp;·&nbsp; Private Events
            </p>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <form
        id="contact-form"
        action="https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID"
        method="POST"
        class="flex flex-col gap-7"
      >
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Name</label>
          <input type="text" id="name" name="name" required placeholder="Your name" class="field" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="company" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Company / Event Type</label>
          <input type="text" id="company" name="company" placeholder="Conference, brand activation, wedding…" class="field" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Email</label>
          <input type="email" id="email" name="email" required placeholder="your@email.com" class="field" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-[11px] font-sans text-ink-light tracking-widest uppercase" style="letter-spacing:0.18em;">Tell Me About Your Event</label>
          <textarea id="message" name="message" rows="5" required placeholder="Dates, location, scale, vision…" class="field resize-none"></textarea>
        </div>

        <div class="pt-1">
          <button type="submit" class="btn">Send Message</button>
        </div>

        <p id="form-success" class="hidden text-ink-mid text-sm font-sans">
          ✓ Message received — I'll be in touch within 24 hours.
        </p>
      </form>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const action = form.getAttribute('action') ?? '';

    if (action.includes('REPLACE_WITH_YOUR_FORM_ID')) {
      success.classList.remove('hidden');
      success.textContent = '✓ (Form not yet connected — see README for Formspree setup.)';
      return;
    }

    const res = await fetch(action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    });

    if (res.ok) {
      form.reset();
      success.classList.remove('hidden');
    }
  });
</script>
