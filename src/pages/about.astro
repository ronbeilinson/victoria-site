---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About — Victoria Tarantino"
  description="Victoria Tarantino is a New York City–based event producer behind the world's most exclusive conferences and international events."
>
  <Nav currentPage="/about" />

  <main class="flex-1">

    <!-- ─── Photo + intro ─── -->
    <section class="px-6 md:px-10 pt-10 pb-16 md:pb-20">
      <div class="rule mb-10"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 lg:gap-24 items-start">

        <!-- Headshot -->
        <div class="w-full">
          <img
            src="/headshot.JPG"
            alt="Victoria Tarantino"
            class="w-full object-cover object-top"
            style="max-height: 680px;"
            loading="eager"
          />
        </div>

        <!-- Bio -->
        <div class="flex flex-col gap-7 md:pt-2">

          <h1
            class="font-serif text-ink leading-tight font-light"
            style="font-size: clamp(2.2rem, 5vw, 3.8rem); font-style: italic;"
          >
            I'm Victoria.
          </h1>

          <div class="rule"></div>

          <div class="flex flex-col gap-4 text-ink-mid text-sm font-sans leading-relaxed" style="letter-spacing:0.01em;">
            <p>
              I'm an event producer based in New York City — and I believe the best events don't just look beautiful, they feel inevitable.
            </p>
            <p>
              I spent five years producing the <span class="text-ink">Sun Valley Conference</span> and the <span class="text-ink">Allen & Co Arizona Conference</span> — two of the most consequential gatherings in media, technology, and finance, where the world's most powerful people come together to shape what's next. Running these events year after year taught me that the detail nobody notices is exactly the one that holds everything together.
            </p>
            <p>
              Most recently I've taken my work global as an international event producer for <span class="text-ink">Endeavor Global</span>, building brand experiences and executive events across Europe, Asia, and the Americas.
            </p>
            <p>
              Whether it's a thousand-person conference in the mountains, a brand activation on the streets of New York, or an intimate dinner in Paris — I bring the same obsessive attention to detail and calm under pressure to every single event.
            </p>
            <p>I'm now available to bring that experience to you.</p>
          </div>

          <div class="flex flex-wrap gap-4 items-center pt-1">
            <a href="/services" class="btn">View Services</a>
            <a href="/contact" class="arrow-link">
              Get in touch
              <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                <path d="M1 10L10 1M10 1H3.5M10 1V7.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
              </svg>
            </a>
          </div>

          <!-- Stats -->
          <div class="border-t border-rule pt-7 grid grid-cols-3 gap-4 text-center">
            <div>
              <p class="font-serif text-3xl text-ink font-light" style="font-style:italic;">5+</p>
              <p class="text-ink-light text-[10px] font-sans tracking-widest uppercase mt-1" style="letter-spacing:0.16em;">Years</p>
            </div>
            <div class="border-x border-rule">
              <p class="font-serif text-3xl text-ink font-light" style="font-style:italic;">3</p>
              <p class="text-ink-light text-[10px] font-sans tracking-widest uppercase mt-1" style="letter-spacing:0.16em;">Continents</p>
            </div>
            <div>
              <p class="font-serif text-3xl text-ink font-light" style="font-style:italic;">100+</p>
              <p class="text-ink-light text-[10px] font-sans tracking-widest uppercase mt-1" style="letter-spacing:0.16em;">Events</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Testimonials ─── -->
    <section class="px-6 md:px-10 py-14 md:py-20 border-t border-rule">
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10 md:gap-20">

        <p class="text-[11px] font-sans tracking-widest uppercase text-ink-mid shrink-0" style="letter-spacing:0.18em;">
          Kind Words
        </p>

        <div class="flex flex-col gap-10 flex-1 max-w-lg">

          <div class="flex flex-col gap-3">
            <p class="font-serif text-ink font-light leading-relaxed" style="font-size:1.15rem; font-style:italic;">
              &ldquo;Placeholder &mdash; add client quote here. Victoria was the most prepared, calm, and professional producer we&rsquo;ve worked with.&rdquo;
            </p>
            <p class="text-ink-light text-xs font-sans" style="letter-spacing:0.04em;">&mdash; Client Name, Company or Event</p>
          </div>

          <div class="flex flex-col gap-3">
            <p class="font-serif text-ink font-light leading-relaxed" style="font-size:1.15rem; font-style:italic;">
              &ldquo;Placeholder &mdash; add client quote here. Every single detail was handled perfectly. We didn&rsquo;t worry about a thing.&rdquo;
            </p>
            <p class="text-ink-light text-xs font-sans" style="letter-spacing:0.04em;">&mdash; Client Name, Company or Event</p>
          </div>

          <div class="flex flex-col gap-3">
            <p class="font-serif text-ink font-light leading-relaxed" style="font-size:1.15rem; font-style:italic;">
              &ldquo;Placeholder &mdash; add client quote here. She understood exactly what we needed before we even finished explaining it.&rdquo;
            </p>
            <p class="text-ink-light text-xs font-sans" style="letter-spacing:0.04em;">&mdash; Client Name, Company or Event</p>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>
