---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About — Victoria Tarantino"
  description="Victoria Tarantino is a New York City–based event producer behind the world's most exclusive conferences and international events."
>
  <Nav currentPage="/about" />

  <main class="flex-1">

    <!-- ─── Photo + intro ─── -->
    <section class="px-6 md:px-10 pt-10 pb-16 md:pb-20">
      <div class="rule mb-10"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 lg:gap-24 items-start">

        <!-- Photo -->
        <div class="w-full">
          <div class="polaroid polaroid-plain mx-auto" style="max-width: 360px;">
            <img
              src="/victoria.png"
              alt="Victoria Tarantino"
              class="w-full object-cover"
              style="aspect-ratio: 2/3; object-position: center 20%;"
              loading="eager"
            />
          </div>
        </div>

        <!-- Bio -->
        <div class="flex flex-col gap-7 md:pt-2">

          <h1
            class="signature text-ink leading-none"
            style="font-size: clamp(2.8rem, 6vw, 5rem);"
          >
            I'm Victoria.
          </h1>

          <div class="rule"></div>

          <div class="flex flex-col gap-4 text-ink-mid text-sm font-sans leading-relaxed" style="letter-spacing:0.01em;">
            <p>
              I'm an event producer born and raised in New York City, and I believe the best events do more than look beautiful. They create meaningful moments that leave a lasting impression.
            </p>
            <p>
              I spent five years producing the <span class="text-ink">Sun Valley Conference</span> and the <span class="text-ink">Arizona Conference</span>, two of the world's most exclusive gatherings of business, media, technology, and political leaders. Working behind the scenes on these events year after year taught me that the smallest details are often the ones that matter most.
            </p>
            <p>
              Most recently, I took my work global as a Global Events Manager at <span class="text-ink">Endeavor Global</span>, leading executive events, brand experiences, and strategic convenings across Europe, Asia, Africa, and the Americas.
            </p>
            <p>
              Whether it's a thousand-person conference in the mountains, a brand activation in New York City, or my own wedding in the Dominican Republic, I bring the same thoughtful attention to detail, creativity, and calm under pressure to every experience I create.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 items-center pt-1">
            <a href="/work" class="btn">See Work</a>
            <a href="/contact" class="arrow-link">
              Get in touch
              <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                <path d="M1 10L10 1M10 1H3.5M10 1V7.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
              </svg>
            </a>
          </div>

          <!-- Stats -->
          <div class="border-t border-rule pt-7 grid grid-cols-3 gap-4 text-center">
            <div>
              <p class="font-serif text-3xl text-ink font-light" style="font-style:italic;">10+</p>
              <p class="text-ink-light text-[10px] font-sans tracking-widest uppercase mt-1" style="letter-spacing:0.16em;">Years</p>
            </div>
            <div class="border-x border-rule">
              <p class="font-serif text-3xl text-ink font-light" style="font-style:italic;">5</p>
              <p class="text-ink-light text-[10px] font-sans tracking-widest uppercase mt-1" style="letter-spacing:0.16em;">Continents</p>
            </div>
            <div>
              <p class="font-serif text-3xl text-ink font-light" style="font-style:italic;">50+</p>
              <p class="text-ink-light text-[10px] font-sans tracking-widest uppercase mt-1" style="letter-spacing:0.16em;">Events</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── More photos ─── -->
    <!--
      Add personal / event photos to /public/images/ and update the src values below.
      Suggested subjects: family, behind-the-scenes at events, travel, candids.
      Any aspect ratio works — the polaroid frame adapts.
    -->
    <section class="px-6 md:px-10 py-14 md:py-20 border-t border-rule">
      <div class="flex items-center gap-6 mb-10">
        <p class="text-[11px] font-sans text-ink-mid tracking-widest uppercase shrink-0" style="letter-spacing:0.18em;">
          Beyond the Events
        </p>
        <div class="rule flex-1"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-5 md:gap-7">
        <!-- Replace src="" with real photo paths, e.g. src="/images/family.jpg" -->
        {[
          { alt: 'Family', bg: '#EAE6DF', src: '/family-1.png' },
          { alt: 'Behind the scenes', bg: '#E4E7E3', src: '/onlocation.png' },
          { alt: 'On location', bg: '#E7E3EA', src: '/behind the scenes.png' },
          { alt: 'Personal', bg: '#E3E6E9', src: '/wedding-1.png' },
        ].map((photo) => (
          <div class="polaroid polaroid-plain w-full" style="padding: 0.75rem;">
            {photo.src
              ? <img src={photo.src} alt={photo.alt} class="w-full object-cover" style="aspect-ratio: 4/5;" />
              : <div class="w-full flex items-end p-2" style={`aspect-ratio: 4/5; background: ${photo.bg};`}>
                  <span class="text-[10px] font-sans text-ink-light opacity-60" style="letter-spacing:0.06em;">{photo.alt}</span>
                </div>
            }
          </div>
        ))}
      </div>
    </section>


  </main>

  <Footer />
</Layout>
