---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav currentPage="/" />

  <main class="flex-1">

    <!-- ─── Hero ─── -->
    <section class="px-6 md:px-10 pt-12 md:pt-16 pb-10 md:pb-14 flex flex-col items-center text-center">
      <h1
        class="signature text-ink"
        style="font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1;"
      >
        Victoria Tarantino
      </h1>

      <p class="text-ink-mid text-[11px] md:text-xs font-sans uppercase mt-5" style="letter-spacing: 0.32em;">
        Global Events &amp; Experiences
      </p>
    </section>

    <!-- ─── Video reel ─── -->
    <section class="px-6 md:px-10 pb-16 md:pb-24">
      <div class="w-full max-w-sm mx-auto">
        <div class="polaroid w-full" style="padding: 0.75rem;">
          <video
            autoplay
            loop
            muted
            playsinline
            class="w-full block"
            style="aspect-ratio: 4/5; object-fit: cover;"
          >
            <source src="/reel.mp4" type="video/mp4" />
            <source src="/reel.mov" type="video/quicktime" />
          </video>
        </div>
      </div>
    </section>


  </main>

  <Footer />
</Layout>
