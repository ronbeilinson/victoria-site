---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

/*
  Service category images: add to /public/images/ and update the src below.
  Recommended: 4:5 portrait ratio, at least 800px wide.
  Placeholder backgrounds are used until real images are added.
*/
const categories = [
  { name: 'Exclusive Conferences', src: '', bg: '#E9E7E3' },
  { name: 'Brand Activations',     src: '', bg: '#E3E6E9' },
  { name: 'International Events',  src: '', bg: '#E6E3E9' },
];

const offerings = [
  {
    heading: 'Planning & Production',
    items: [
      'Site selection & venue negotiation',
      'Full vendor sourcing & management',
      'Budget development & oversight',
      'Run-of-show & logistics',
      'VIP & speaker coordination',
      'Security & media logistics',
      'On-site production management',
    ],
  },
  {
    heading: 'Brand Experience Design',
    items: [
      'Event concept & creative direction',
      'Environmental & spatial design',
      'Custom branding & signage',
      'Guest journey mapping',
      'Brand activation strategy',
      'Fabrication sourcing',
      'Content & press coordination',
    ],
  },
  {
    heading: 'Day-of Management',
    items: [
      'Full event-day staffing',
      'Vendor load-in oversight',
      'Guest check-in & hospitality',
      'Real-time problem solving',
      'Breakdown coordination',
      'Post-event debrief',
    ],
  },
];
---

<Layout
  title="Services — Victoria Tarantino"
  description="Full-service event planning, brand activations, and international event production."
>
  <Nav currentPage="/services" />

  <main class="flex-1 px-6 md:px-10 pt-10 pb-20">
    <div class="rule mb-10"></div>

    <!-- Tagline — sjbruce style statement at top of services -->
    <h1
      class="font-serif text-ink font-light leading-snug mb-14 md:mb-20"
      style="font-size: clamp(1.8rem, 4vw, 3.2rem); max-width: 34ch;"
    >
      From intimate dinner parties to global summits — I can assist with any type of gathering.
    </h1>

    <!-- Category images — sjbruce services layout -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 md:gap-8 mb-20 md:mb-28">
      {categories.map((cat) => (
        <div class="flex flex-col gap-3">
          {cat.src
            ? <img src={cat.src} alt={cat.name} class="w-full object-cover" style="aspect-ratio:4/5;" />
            : (
              <div
                class="w-full flex items-end p-4"
                style={`aspect-ratio:4/5; background:${cat.bg};`}
              >
                <span class="text-[10px] font-sans text-ink-light" style="letter-spacing:0.06em;">Add image</span>
              </div>
            )
          }
          <p class="text-sm font-sans text-ink">{cat.name}</p>
        </div>
      ))}
    </div>

    <!-- Service list columns -->
    <div class="rule mb-12"></div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-14">
      {offerings.map((section) => (
        <div class="flex flex-col gap-5">
          <h2 class="font-serif text-ink font-light text-xl">{section.heading}</h2>
          <div class="rule"></div>
          <ul class="flex flex-col gap-2">
            {section.items.map((item) => (
              <li class="text-ink-mid text-sm font-sans leading-snug" style="letter-spacing:0.01em;">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="rule mt-14 mb-10"></div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <p class="text-ink-mid text-sm font-sans" style="max-width:42ch; letter-spacing:0.01em;">
        Every event is different. Let's talk about what you're building.
      </p>
      <a href="/contact" class="btn shrink-0">Start a Project</a>
    </div>
  </main>

  <Footer />
</Layout>
