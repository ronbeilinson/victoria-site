---

<Layout
  title="Work — Victoria Tarantino"
  description="Selected events, conferences, and brand experiences produced by Victoria Tarantino."
>
  <Nav currentPage="/work" />

  <main class="flex-1 px-6 md:px-10 pt-10 pb-20">
    <div class="rule mb-10"></div>

    <!-- Header + resume button -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-16 md:mb-20">
      <h1
        class="signature text-ink leading-none"
        style="font-size: clamp(2.6rem, 6.5vw, 5rem);"
      >
        Work
      </h1>

      <!-- Upload resume.pdf to /public/ and this button will work -->
      <a
        href="/Victoria_Tarantino_Resume_626.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="btn shrink-0 self-start sm:self-auto"
      >
        Download My Resume
        <svg class="inline-block ml-2 mb-0.5" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M5 1v5M5 6l-2-2M5 6l2-2M1 9h8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Work sections -->
    <div class="flex flex-col gap-16 md:gap-24">
      {sections.map((section) => (
        <div>
          <!-- Category label -->
          <div class="flex items-center gap-6 mb-8">
            <p class="text-[11px] font-sans text-ink-mid tracking-widest uppercase shrink-0" style="letter-spacing:0.18em;">
              {section.category}
            </p>
            <div class="rule flex-1"></div>
          </div>

          <!-- Grid or horizontal scroll -->
          <div class={section.scrollable ? 'scroll-row' : 'grid grid-cols-3 md:grid-cols-4 gap-3 md:gap-4'}>
            {section.items.map((item) => {
              const Wrapper = item.href ? 'a' : 'div';
              const wrapperProps = item.href
                ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
                : {};
              return (
                <div class={`work-item flex flex-col gap-2.5 cursor-default${section.scrollable ? ' scroll-card' : ''}`}>
                  <div class="polaroid w-full relative overflow-hidden group">
                    {item.src
                      ? (
                        <div class="w-full" style="aspect-ratio:1/1; position:relative;">
                          <img
                            src={item.src}
                            alt={item.name}
                            style={`position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:${item.objectPosition ?? 'center'};${(item.zoom || item.offsetY) ? ` transform:scale(${item.zoom ?? 1}) translateY(${item.offsetY ?? 0}%);` : ''}`}
                          />
                          <!-- Hover overlay -->
                          <div class="work-overlay">
                            <p class="text-[#F7F3EB] text-xs font-sans leading-relaxed" style="letter-spacing:0.01em;" set:html={item.description} />
                            {item.href && (
                              <p class="text-[#F7F3EB] text-[10px] font-sans tracking-widest uppercase mt-3 opacity-70" style="letter-spacing:0.18em;">
                                Open ↗
                              </p>
                            )}
                          </div>
                        </div>
                      ) : (
                        <div
                          class="w-full"
                          style={`aspect-ratio:1/1; background:${item.bg}; position:relative;`}
                        >
                          <!-- Hover overlay on placeholder -->
                          <div class="work-overlay">
                            <p class="text-[#F7F3EB] text-xs font-sans leading-relaxed" style="letter-spacing:0.01em;" set:html={item.description} />
                            {item.href && (
                              <p class="text-[#F7F3EB] text-[10px] font-sans tracking-widest uppercase mt-3 opacity-70" style="letter-spacing:0.18em;">
                                Open ↗
                              </p>
                            )}
                          </div>
                        </div>
                      )
                    }
                  </div>
                  <div class="mt-2">
                    <p class="text-xs font-sans text-ink leading-snug" style="letter-spacing:0.02em;">{item.name}</p>
                    {item.company && (
                      <p class="text-[11px] font-sans text-ink-mid mt-0.5" style="letter-spacing:0.02em;">{item.company}</p>
                    )}
                    {item.client && (
                      <p class="text-[11px] font-sans text-ink-light mt-0.5" style="letter-spacing:0.02em;">{item.client}</p>
                    )}
                    {item.year && (
                      <p class="text-[11px] font-sans text-ink-light" style="letter-spacing:0.02em;">{item.year}</p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom resume CTA -->
    <div class="rule mt-20 mb-10"></div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <p class="text-ink-mid text-sm font-sans" style="max-width:44ch; letter-spacing:0.01em;">
        For the full picture, download my resume or get in touch.
      </p>
      <div class="flex flex-wrap gap-4">
