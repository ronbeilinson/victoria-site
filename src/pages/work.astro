---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

/*
  Add real event photos to /public/images/ and set src on each item.
  Recommended: consistent 4:5 portrait ratio, 800px+ wide.

  To link an item to a new tab (news article, press, etc.),
  set href to the full URL — e.g. 'https://example.com/article'

  To upload the resume:
  - Save the PDF as /public/resume.pdf
  - The Download Resume button will work automatically.
*/
const sections = [
  {
    category: 'Conferences & Executive Experiences',
    items: [
      {
        name: 'Sun Valley Conference',
        client: 'Allen & Co',
        year: '2019–2023',
        description: 'Annual invite-only gathering of the world\'s most influential leaders in media, technology, and finance. Produced end-to-end for five consecutive years.',
        src: '',
        bg: '#E9E7E3',
        href: '',
      },
      {
        name: 'Allen & Co Arizona Conference',
        client: 'Allen & Co',
        year: '2019–2023',
        description: 'Exclusive winter conference for top executives across investment banking, entertainment, and tech. Full logistics, VIP coordination, and on-site management.',
        src: '',
        bg: '#ECEAE6',
        href: '',
      },
    ],
  },
  {
    category: 'Global Programs',
    items: [
      {
        name: 'Endeavor Global Summit',
        client: 'Endeavor',
        year: '2024',
        description: 'Global leadership summit bringing together Endeavor\'s network of high-impact entrepreneurs, mentors, and investors across continents.',
        src: '',
        bg: '#E4E7EA',
        href: '',
      },
      {
        name: 'Endeavor EMEA Forum',
        client: 'Endeavor',
        year: '2024',
        description: 'Regional forum across Europe, the Middle East, and Africa — coordinating venue, programming, and hospitality across multiple cities.',
        src: '',
        bg: '#E7EAE4',
        href: '',
      },
      {
        name: 'Endeavor Asia-Pacific',
        client: 'Endeavor',
        year: '2025',
        description: 'Executive events spanning the Asia-Pacific region, including keynotes, working dinners, and site visits across multiple countries.',
        src: '',
        bg: '#EAE7E4',
        href: '',
      },
    ],
  },
  {
    category: 'Brand Activations & Private Gatherings',
    items: [
      {
        name: 'Brand Activation — NYC',
        client: '',
        year: '2024',
        description: 'Street-level brand experience in New York City — spatial design, vendor management, guest journey, and day-of production.',
        src: '',
        bg: '#E9E4EA',
        href: '',
      },
      {
        name: 'Executive Dinner Series',
        client: '',
        year: '2024',
        description: 'Intimate curated dinner series for C-suite guests — venue, menu curation, seating, and bespoke atmosphere design.',
        src: '',
        bg: '#E4EAE9',
        href: '',
      },
    ],
  },
];
---

<Layout
  title="Work — Victoria Tarantino"
  description="Selected events, conferences, and brand experiences produced by Victoria Tarantino."
>
  <Nav currentPage="/work" />

  <main class="flex-1 px-6 md:px-10 pt-10 pb-20">
    <div class="rule mb-10"></div>

    <!-- Header + resume button -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-16 md:mb-20">
      <h1
        class="signature text-ink leading-none"
        style="font-size: clamp(2.6rem, 6.5vw, 5rem);"
      >
        Work
      </h1>

      <!-- Upload resume.pdf to /public/ and this button will work -->
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="btn shrink-0 self-start sm:self-auto"
      >
        Download My Resume
        <svg class="inline-block ml-2 mb-0.5" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M5 1v5M5 6l-2-2M5 6l2-2M1 9h8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Work sections -->
    <div class="flex flex-col gap-16 md:gap-24">
      {sections.map((section) => (
        <div>
          <!-- Category label -->
          <div class="flex items-center gap-6 mb-8">
            <p class="text-[11px] font-sans text-ink-mid tracking-widest uppercase shrink-0" style="letter-spacing:0.18em;">
              {section.category}
            </p>
            <div class="rule flex-1"></div>
          </div>

          <!-- Grid: 2 col mobile, 3 col desktop -->
          <div class="grid grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
            {section.items.map((item) => {
              const Wrapper = item.href ? 'a' : 'div';
              const wrapperProps = item.href
                ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
                : {};
              return (
                <div class="work-item flex flex-col gap-2.5 cursor-default">
                  <div class="polaroid w-full relative overflow-hidden group">
                    {item.src
                      ? (
                        <div style="aspect-ratio:1/1; position:relative;">
                          <img
                            src={item.src}
                            alt={item.name}
                            class="w-full h-full object-cover"
                          />
                          <!-- Hover overlay -->
                          <div class="work-overlay">
                            <p class="text-[#F7F3EB] text-xs font-sans leading-relaxed" style="letter-spacing:0.01em;">{item.description}</p>
                            {item.href && (
                              <p class="text-[#F7F3EB] text-[10px] font-sans tracking-widest uppercase mt-3 opacity-70" style="letter-spacing:0.18em;">
                                Open ↗
                              </p>
                            )}
                          </div>
                        </div>
                      ) : (
                        <div
                          class="w-full"
                          style={`aspect-ratio:1/1; background:${item.bg}; position:relative;`}
                        >
                          <!-- Hover overlay on placeholder -->
                          <div class="work-overlay">
                            <p class="text-[#F7F3EB] text-xs font-sans leading-relaxed" style="letter-spacing:0.01em;">{item.description}</p>
                            {item.href && (
                              <p class="text-[#F7F3EB] text-[10px] font-sans tracking-widest uppercase mt-3 opacity-70" style="letter-spacing:0.18em;">
                                Open ↗
                              </p>
                            )}
                          </div>
                        </div>
                      )
                    }
                  </div>
                  <div>
                    <p class="text-[11px] font-sans text-ink uppercase leading-snug mt-1" style="letter-spacing:0.14em;">{item.name}</p>
                    {item.client && (
                      <p class="text-xs font-sans text-ink-light mt-0.5" style="letter-spacing:0.02em;">{item.client} · {item.year}</p>
                    )}
                    {!item.client && (
                      <p class="text-xs font-sans text-ink-light mt-0.5" style="letter-spacing:0.02em;">{item.year}</p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom resume CTA -->
    <div class="rule mt-20 mb-10"></div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <p class="text-ink-mid text-sm font-sans" style="max-width:44ch; letter-spacing:0.01em;">
        Want to see the full picture? Download my resume or get in touch directly.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn shrink-0"
        >
          Download My Resume
        </a>
        <a href="/contact" class="arrow-link self-center">
          Get in touch
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
            <path d="M1 10L10 1M10 1H3.5M10 1V7.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .work-overlay {
    position: absolute;
    inset: 0;
    background: rgba(33, 30, 24, 0.78);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 14px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .polaroid:hover .work-overlay {
    opacity: 1;
  }
</style>
